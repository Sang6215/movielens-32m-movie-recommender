# .streamlit/secrets.toml — Cấu hình TMDB API Read Access Token
# Đổi tên file này thành `secrets.toml` trong thư mục `.streamlit/` và điền token của bạn.
# Lấy token tại: https://www.themoviedb.org/settings/api (API Read Access Token v4)

TMDB_READ_ACCESS_TOKEN = "YOUR_TMDB_READ_ACCESS_TOKEN_HERE"
